{
	"name": "@trainpaths/nb-ui",
	"version": "0.1.0",
	"description": "Vue 3 + Tailwind v4 UI components, shipped as source with per-component overrides",
	"license": "MIT",
	"type": "module",
	"packageManager": "pnpm@12.6.0",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/trainpaths/nb-ui.git"
	},
	"exports": {
		".": "./index.ts",
		"./theme.css": "./theme.css",
		"./vite": {
			"types": "./vite-plugin.d.ts",
			"default": "./vite-plugin.js"
		},
		"./src/*": "./src/*"
	},
	"files": [
		"index.ts",
		"theme.css",
		"vite-plugin.js",
		"vite-plugin.d.ts",
		"src"
	],
	"scripts": {
		"dev": "vite",
		"build": "vite build",
		"typecheck": "vue-tsc --noEmit"
	},
	"peerDependencies": {
		"tailwindcss": "^4",
		"vite": ">=6",
		"vue": "^3.5",
		"vue-router": ">=4"
	},
	"peerDependenciesMeta": {
		"vite": {
			"optional": true
		},
		"vue-router": {
			"optional": true
		}
	},
	"devDependencies": {
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^26.6.3",
		"@vitejs/plugin-vue": "^6.0.9",
		"@vue/tsconfig": "^0.9.1",
		"tailwindcss": "^4.3.3",
		"typescript": "~6.0.3",
		"vite": "^8.3.1",
		"vue": "^3.5.43",
		"vue-router": "^5.3.1",
		"vue-tsc": "^3.3.11"
	}
}
